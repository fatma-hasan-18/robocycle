# ---------------------------------------------------------------------------
# Supabase — مشروع robocycle
# انسخ هذا الملف إلى .env.local واملأ القيم من:
#   Supabase Dashboard → Project Settings → API
# ---------------------------------------------------------------------------

# عنوان المشروع (عام، يظهر في المتصفح)
NEXT_PUBLIC_SUPABASE_URL=https://kaanfupnhyleeuiqzvvq.supabase.co

# المفتاح العام (publishable / anon) — مصمَّم ليكون عامًا، محميًا بـ RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# مفتاح الخدمة — يتجاوز RLS بالكامل.
# للخادم فقط: لا يبدأ بـ NEXT_PUBLIC_ ولا يُستورد في أي مكوّن عميل.
SUPABASE_SERVICE_ROLE_KEY=

# عنوان الموقع (يُستخدم في روابط تأكيد البريد و OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
