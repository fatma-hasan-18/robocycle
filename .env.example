# ---------------------------------------------------------------------------
# RoboCycle — متغيّرات البيئة
#
#   cp .env.example .env.local
#
# القيمتان أدناه عامّتان بطبيعتهما: المفتاح "publishable" مصمَّم ليُشحن في
# المتصفح، وحمايته تأتي من سياسات RLS في قاعدة البيانات لا من إخفائه.
# ---------------------------------------------------------------------------

# مطلوب
NEXT_PUBLIC_SUPABASE_URL=https://kaanfupnhyleeuiqzvvq.supabase.co

# مطلوب
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_M04qbIPvqmHr9emblOAQPA_W9um_BHx

# ---------------------------------------------------------------------------
# اختياري
# ---------------------------------------------------------------------------

# عنوان الموقع المستخدم في روابط تأكيد البريد و OAuth.
# إن تُرك فارغًا يُشتقّ تلقائيًا من ترويسة الطلب (host)، وهو ما يعمل على
# Vercel وعلى localhost بلا ضبط. اضبطيه فقط إذا كان الموقع خلف بروكسي
# يغيّر الـ host، أو أردتِ تثبيت نطاق بعينه.
# NEXT_PUBLIC_SITE_URL=https://example.vercel.app

# مفتاح الخدمة — يتجاوز RLS بالكامل. غير مطلوب حاليًا: createAdminClient
# معرَّفة في lib/supabase/server.ts لكن لا يستدعيها أي كود بعد. أضيفيه فقط
# عند إضافة مهمة إدارية تحتاجه، وللخادم وحده (بلا بادئة NEXT_PUBLIC_).
# SUPABASE_SERVICE_ROLE_KEY=
